# Secrets - never commit
.env
.env.*
!.env.example
*.creds
.bootstrap-pw

# Database dumps / backups - never commit (may contain user data)
backups/
*.dump
*.sql.gz
*.bak
*.backup
**/metadata-backups/
**/project-isolation/backups/

# Python cache
__pycache__/
*.py[cod]
*.pyc
*.pyo

# OS / editor
.DS_Store
*.swp
*.swo
*~

# WireGuard keys (if ever placed in repo)
*.priv
*.pub
wg0.conf
wg/

# Local config overrides
config/*.local.yml
.broker-keys/
