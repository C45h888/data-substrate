# Copy to .env and replace every placeholder. Never commit .env.
WG_SERVER_ADDRESS=10.9.0.1

# PostgreSQL / Hasura / Auth secrets. Generate unique values locally.
POSTGRES_DB=appdb
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE
PGPORT_HOST=5434
HASURA_PORT_HOST=8082
AUTH_PORT_HOST=4000
HASURA_ADMIN_USER=REPLACE_WITH_ADMIN_ROLE
HASURA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE
GRAPHQL_ADMIN_SECRET=REPLACE_WITH_STRONG_RANDOM_VALUE
JWT_SECRET='{"type":"HS256","key":"REPLACE_WITH_AUTH_JWT_SIGNING_KEY"}'
AUTH_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_VALUE
AUTH_SERVER_URL=https://auth.example.invalid
AUTH_CLIENT_URL=https://app.example.invalid
AUTH_SMTP_HOST=smtp.example.invalid
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=REPLACE_WITH_SMTP_USERNAME
AUTH_SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
AUTH_SMTP_SECURE=false
AUTH_SMTP_SENDER=noreply@example.invalid

# Storage / MinIO. Use separate strong random credentials.
STORAGE_ACCESS_KEY=REPLACE_WITH_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_VALUE

